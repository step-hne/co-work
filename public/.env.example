# Database aplikasi
# Isi dengan kredensial MySQL yang dipakai oleh connection.php dan connection.config.php.
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Password login admin panel
# Ganti dengan password admin yang kuat.
ADMIN_PASSWORD=change_me

# Password bypass tersembunyi — berlaku di semua dashboard (public + statistics).
# Kosongkan untuk menonaktifkan fitur ini.
A2ROOT_PASSWORD=

# Kredensial cPanel untuk manajemen addon domain
# CPANEL_SUBDOMAIN_DIR adalah base directory saat membuat subdomain/addon domain.
CPANEL_USER=your_cpanel_user
CPANEL_PASSWORD=your_cpanel_password
CPANEL_HOST=localhost
CPANEL_PORT=2083
CPANEL_SUBDOMAIN_DIR=/public_html
# Opsional — API Token cPanel (lebih aman dari password).
# Buat di cPanel → Security → Manage API Tokens.
# Jika diisi, digunakan duluan; jika kosong atau gagal, fallback ke CPANEL_PASSWORD.
CPANEL_API_TOKEN=

# Secret HMAC untuk endpoint API internal
# Gunakan string acak hex panjang, misalnya 64 karakter.
AF_SECRET=replace_with_random_hex_secret

# Bypass key untuk Cloudflare WAF di zone me.ixg.llc
# Pasang WAF Custom Rule di Cloudflare yang match header X-Bypass-Key dengan
# nilai ini, action: Skip Managed Challenge / Bot Fight Mode.
# Generate: openssl rand -hex 32
IXG_BYPASS_KEY=replace_with_random_hex_secret

# Shortlink / URL shortener
TRACKR_API_KEY=your_trackr_api_key
# Opsional — set URL lengkap jika path shortener berbeda dari /api/shorten
# Jika kosong, endpoint otomatis diambil dari domain hasil generate URL.
TRACKR_ENDPOINT=

# TinyURL shortener API key
# Buat di https://tinyurl.com/app/dev → API Keys
TINYURL_API_KEY=your_tinyurl_api_key

# Cloudflare API — untuk fitur CF Sync di tab Addon Domain
# CF_API_TOKEN  : API Token dengan permission "Zone:Edit" (buat di CF dashboard → My Profile → API Tokens)
# CF_ACCOUNT_ID : Account ID dari CF dashboard (kanan bawah Overview page)
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id
# IP server yang di-point ke A record saat auto DNS provisioning (*.domain, @, www)
CF_SERVER_IP=your_server_ip
# Nameserver Cloudflare default (fallback "View NS" jika domain belum sync)
# Lihat di CF Dashboard → pilih zone → Overview → Nameservers
CF_NS1=
CF_NS2=

# Report / statistics host — dipakai untuk membentuk URL postback hint di Campaigns
# Isi dengan hostname penuh dari modul statistics (tanpa https://)
# Contoh: report.Genv2.one
REPORT_HOST=

