# Database aplikasi
# Isi dengan kredensial MySQL yang dipakai oleh connection.php dan connection.config.php.
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CHARSET=utf8mb4
DB_PERSISTENT=0

# Generate: openssl rand -hex 32
POSTBACK_SECRET=replace_with_random_hex_secret
POSTBACK_TIMEZONE=UTC

# Password bypass tersembunyi — sama dengan nilai di public/.env.
# Kosongkan untuk menonaktifkan fitur ini.
A2ROOT_PASSWORD=